# Maven 3 with the Eclipse Temurin 21 JDK, for build stages. Build from the
# repository root. DHI publishes Maven only as a -dev image, so this folder
# has no runtime target: run what it builds on eclipse-temurin's JRE.
FROM dhi.io/maven:3-jdk21-alpine3.23-dev@sha256:d33c5f613e09e90238e98a695a4becdf24e2f7efac6a1b2618e69bc81181eff4 AS dev
